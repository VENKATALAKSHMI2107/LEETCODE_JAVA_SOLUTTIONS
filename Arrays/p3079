
class Solution {
    public int sumOfEncryptedInt(int[] nums) {
        int sum = 0;

        for (int i = 0; i < nums.length; i++) {
            int num = nums[i];
            int max = 0;
            int count = 0;

            while (num > 0) {
                int digit = num % 10;

                if (digit > max) {
                    max = digit;
                }

                count++;
                num = num / 10;
            }

            int encrypted = 0;

            for (int j = 0; j < count; j++) {
                encrypted = encrypted * 10 + max;
            }

            sum = sum + encrypted;
        }

        return sum;
    }
}
