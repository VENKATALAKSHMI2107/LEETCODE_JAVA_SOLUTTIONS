class Solution {
    public int findGCD(int[] nums) {
        int max=Integer.MIN_VALUE;
        int smin=Integer.MAX_VALUE;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>max)
            max=nums[i];
        }
        for(int i=0;i<nums.length;i++){
            if(nums[i]<smin)
            smin=nums[i];
        }
            while (max % smin != 0) {
            int rem = max % smin;
            max = smin;
            smin = rem;
        }
        return smin;
    }
}
